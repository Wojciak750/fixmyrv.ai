{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "core",
    "server",
    "test",
    "scripts"
  ],
  "exclude": [
    "scripts/deno-smoke.ts",
    "supabase",
    "web"
  ]
}